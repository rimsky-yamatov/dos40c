# DOS40C - MS-DOS 4.0 core ported to C
CC      ?= gcc
LD      ?= ld
OBJCOPY ?= objcopy
HOSTCC  ?= gcc

B := build

# 16-bit real mode code generated by GCC (-m16 emits .code16gcc)
CFLAGS16 := -m16 -march=i386 -std=gnu11 -Os -Wall -Wextra \
            -ffreestanding -fno-pic -fno-pie -fno-stack-protector \
            -fcf-protection=none -fno-asynchronous-unwind-tables \
            -fno-unwind-tables -fomit-frame-pointer \
            -fno-tree-loop-distribute-patterns -mno-sse -Ikernel

KERNEL_C := main hal_bios lib dos_alloc dos_fat dos_dir dos_handle \
            dos_cpmio dos_exec dos_dispatch command
KERNEL_OBJS := $(B)/entry.o $(B)/isr.o $(addprefix $(B)/,$(addsuffix .o,$(KERNEL_C)))

.PHONY: all clean image
all: image

image: $(B)/dos40c.img $(B)/dos40c-test.img

$(B):
	mkdir -p $(B)

$(B)/boot.o: boot/boot.S | $(B)
	$(CC) -m16 -c -o $@ $<

$(B)/boot.bin: $(B)/boot.o
	$(LD) -m elf_i386 -nostdlib -Ttext=0x7C00 --oformat binary -o $@ $<

$(B)/%.o: kernel/%.S | $(B)
	$(CC) -m16 -c -o $@ $<

$(B)/%.o: kernel/%.c kernel/*.h | $(B)
	$(CC) $(CFLAGS16) -c -o $@ $<

$(B)/kernel.elf: $(KERNEL_OBJS) kernel/link.ld
	$(LD) -m elf_i386 -nostdlib -T kernel/link.ld -Map=$(B)/kernel.map -o $@ $(KERNEL_OBJS)

$(B)/kernel.bin: $(B)/kernel.elf
	$(OBJCOPY) -O binary $< $@
	@echo "kernel.bin: `wc -c < $@` bytes"

# ---------------- sample programs and disk images ----------------
$(B)/%.o: sample/%.S | $(B)
	$(CC) -m16 -c -o $@ $<

$(B)/HELLO.COM: $(B)/hello.o
	$(LD) -m elf_i386 -nostdlib -Ttext=0x100 --oformat binary -o $@ $<

$(B)/DOSTEST.COM: $(B)/dostest.o
	$(LD) -m elf_i386 -nostdlib -Ttext=0x100 --oformat binary -o $@ $<

$(B)/mkfat: tools/mkfat.c | $(B)
	$(HOSTCC) -O2 -Wall -Wextra -o $@ $<

SAMPLES := $(B)/HELLO.COM $(B)/DOSTEST.COM sample/README.TXT

# release image: boots to the prompt after AUTOEXEC.BAT
$(B)/dos40c.img: $(B)/mkfat $(B)/boot.bin $(B)/kernel.bin $(SAMPLES) sample/AUTOEXEC.BAT
	$(B)/mkfat $@ $(B)/boot.bin $(B)/kernel.bin $(SAMPLES) sample/AUTOEXEC.BAT

# CI image: AUTOEXEC.BAT runs the self test and powers the VM off
$(B)/dos40c-test.img: $(B)/mkfat $(B)/boot.bin $(B)/kernel.bin $(SAMPLES) sample/SELFTEST.BAT
	$(B)/mkfat $@ $(B)/boot.bin $(B)/kernel.bin $(SAMPLES) sample/SELFTEST.BAT:AUTOEXEC.BAT

# ---------------- QEMU ----------------
QEMU ?= qemu-system-i386

.PHONY: run run-serial smoke emu-test
run: $(B)/dos40c.img
	$(QEMU) -drive file=$<,format=raw,if=floppy -boot a

run-serial: $(B)/dos40c.img
	$(QEMU) -drive file=$<,format=raw,if=floppy -boot a -display none -serial stdio

smoke: $(B)/dos40c-test.img
	sh tools/smoke.sh $<

# QEMU-free check: boots the images in tests/emu/rmemu.py
emu-test: $(B)/dos40c-test.img $(B)/dos40c.img
	python3 tests/emu/run_emu.py $(B)/dos40c-test.img \
		--expect "SELFTEST BEGIN" --expect "Volume in drive A is DOS40C" \
		--expect "HELLO    COM" --expect "Hello from a DOS COM program!" \
		--expect "reports DOS major version 4" \
		--expect "PASS: open/read/write/lseek/close" \
		--expect "PASS: findfirst/findnext" --expect "PASS: alloc/free" \
		--expect "SELFTEST END" \
		--expect "DOS40C: HALT"
	python3 tests/emu/run_emu.py $(B)/dos40c.img \
		--keys 'VER\rDIR\rHELLO\rNOPE\rMEM\r' \
		--expect "Welcome to DOS40C" --expect "Version 4.00" \
		--expect "README   TXT" --expect "Hello from a DOS COM program!" \
		--expect "Bad command or file name" --expect "bytes free"

clean:
	rm -rf $(B)

# ---------------- host tests ----------------
HOST_SRCS := kernel/dos_alloc.c kernel/dos_fat.c kernel/dos_dir.c \
             kernel/dos_handle.c tests/hal_host.c tests/test_core.c

$(B)/test_core: $(HOST_SRCS) $(B)/boot.bin | $(B)
	$(HOSTCC) -g -O0 -Wall -Wextra -DHOST_TEST -DBOOT_BIN='"$(B)/boot.bin"' \
		-Ikernel -o $@ $(HOST_SRCS)

.PHONY: test
test: $(B)/test_core
	$(B)/test_core
