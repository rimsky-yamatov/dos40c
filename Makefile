# DOS40C - MS-DOS 4.0 core ported to C
CC      ?= gcc
LD      ?= ld
OBJCOPY ?= objcopy
HOSTCC  ?= gcc

B := build

# 16-bit real mode code generated by GCC (-m16 emits .code16gcc)
CFLAGS16 := -m16 -march=i386 -std=gnu11 -Os -Wall -Wextra \
            -ffreestanding -fno-pic -fno-pie -fno-stack-protector \
            -fcf-protection=none -fno-asynchronous-unwind-tables \
            -fno-unwind-tables -fomit-frame-pointer \
            -fno-tree-loop-distribute-patterns -mno-sse -Ikernel

KERNEL_C := main hal_bios lib dos_alloc dos_fat dos_dir dos_handle \
            dos_cpmio dos_exec dos_dispatch command
KERNEL_OBJS := $(B)/entry.o $(B)/isr.o $(addprefix $(B)/,$(addsuffix .o,$(KERNEL_C)))

.PHONY: all clean
all: $(B)/boot.bin $(B)/kernel.bin

$(B):
	mkdir -p $(B)

$(B)/boot.o: boot/boot.S | $(B)
	$(CC) -m16 -c -o $@ $<

$(B)/boot.bin: $(B)/boot.o
	$(LD) -m elf_i386 -nostdlib -Ttext=0x7C00 --oformat binary -o $@ $<

$(B)/%.o: kernel/%.S | $(B)
	$(CC) -m16 -c -o $@ $<

$(B)/%.o: kernel/%.c kernel/*.h | $(B)
	$(CC) $(CFLAGS16) -c -o $@ $<

$(B)/kernel.elf: $(KERNEL_OBJS) kernel/link.ld
	$(LD) -m elf_i386 -nostdlib -T kernel/link.ld -Map=$(B)/kernel.map -o $@ $(KERNEL_OBJS)

$(B)/kernel.bin: $(B)/kernel.elf
	$(OBJCOPY) -O binary $< $@
	@echo "kernel.bin: `wc -c < $@` bytes"

clean:
	rm -rf $(B)

# ---------------- host tests ----------------
HOST_SRCS := kernel/dos_alloc.c kernel/dos_fat.c kernel/dos_dir.c \
             kernel/dos_handle.c tests/hal_host.c tests/test_core.c

$(B)/test_core: $(HOST_SRCS) $(B)/boot.bin | $(B)
	$(HOSTCC) -g -O0 -Wall -Wextra -DHOST_TEST -DBOOT_BIN='"$(B)/boot.bin"' \
		-Ikernel -o $@ $(HOST_SRCS)

.PHONY: test
test: $(B)/test_core
	$(B)/test_core
